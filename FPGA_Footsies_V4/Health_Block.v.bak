module Health_Block (
    input clk,
    input reset,
    input got_hit,
    input blocked,
    output reg [2:0] health,
    output reg [2:0] block
);
    reg prev_hit;
    reg prev_blocked;
    wire hit_flag = got_hit & ~prev_hit;
    wire block_flag = blocked & ~prev_blocked;
    
    // State parameters
    localparam threelives = 3'b111, twolives = 3'b011, onelive = 3'b001, dead = 3'b000;
    localparam threeblock = 3'b111, twoblocks = 3'b011, oneblock = 3'b001, noblock = 3'b000;
    
    initial begin
        health = threelives;
        block = threeblock;
        prev_hit = 1'b0;
        prev_blocked = 1'b0;
    end 
    
    always @(posedge clk) begin
        if (reset) begin
            health <= threelives;
            block <= threeblock;
            prev_hit <= 1'b0;
            prev_blocked <= 1'b0;
        end else begin
            prev_hit <= got_hit;
            prev_blocked <= blocked;
            
            // Health state transitions
            if (hit_flag) begin
                case (health)
                    threelives: health <= twolives;
                    twolives:   health <= onelive;
                    onelive:    health <= dead;
                    dead:       health <= dead;
                    default:    health <= threelives;
                endcase
            end
            
            // Block state transitions
            if (block_flag) begin
                case (block)
                    threeblock: block <= twoblocks;
                    twoblocks:  block <= oneblock;
                    oneblock:   block <= noblock;
                    noblock:    block <= noblock;
                    default:    block <= threeblock;
                endcase
            end
        end
    end
endmodule